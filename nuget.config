<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="/app/.nuget/packages" />
    <add key="local-nuget" value="/tmp/local-nuget" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="/app/.nuget/packages" />
  </config>
</configuration>
